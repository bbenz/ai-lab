{
  "uid": "lab723-ai-inference",
  "title": "LAB723 - AI inference",
  "description": "The inference service in the ai-lab namespace: request rate, latency, CPU use compared with limits, CPU throttling, replicas, nodes, and GPU utilization, plus the Ray pods' CPU for Exercise 5. Metrics arrive a few minutes after the cluster and the application emit them.",
  "tags": ["lab723", "aks", "inference"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus data source",
        "description": "The lab's Azure Monitor workspace.",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      },
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "description": "The cluster label that Azure Monitor managed Prometheus adds to every series.",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": { "query": "label_values(kube_node_info, cluster)", "refId": "cluster" },
        "definition": "label_values(kube_node_info, cluster)",
        "refresh": 1,
        "hide": 0,
        "current": {}
      },
      {
        "type": "constant",
        "name": "namespace",
        "query": "ai-lab",
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Predictions per second that the inference pods served, by device.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (device) (rate(lab723_inference_requests_total{cluster=\"$cluster\", namespace=\"$namespace\", outcome=\"ok\"}[1m]))",
          "legendFormat": "{{device}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency, p50 and p95",
      "description": "Time that the server spent on each prediction, including time spent waiting for the model. The lab client's bench command reports the same percentiles immediately.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.50, sum by (le, device) (rate(lab723_inference_request_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\"}[2m])))",
          "legendFormat": "p50 {{device}}"
        },
        {
          "refId": "B",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, device) (rate(lab723_inference_request_duration_seconds_bucket{cluster=\"$cluster\", namespace=\"$namespace\"}[2m])))",
          "legendFormat": "p95 {{device}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU use compared with the limit",
      "description": "Each inference pod's CPU use as a percentage of its CPU limit. The dashed line is the Horizontal Pod Autoscaler's 60 percent target. The request equals the limit, so it's also a percentage of the request.",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\", namespace=\"$namespace\", container=\"inference\"}[1m])) / sum by (pod) (kube_pod_container_resource_limits{cluster=\"$cluster\", namespace=\"$namespace\", container=\"inference\", resource=\"cpu\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "dashed" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 60 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU throttling",
      "description": "The percentage of 100-millisecond scheduling periods in which each inference pod used its entire CPU quota and had to wait. The same counters as nr_throttled and nr_periods in cpu.stat.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{cluster=\"$cluster\", namespace=\"$namespace\", container=~\"inference\"}[1m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{cluster=\"$cluster\", namespace=\"$namespace\", container=~\"inference\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Replicas",
      "description": "Available replicas of the inference deployments, and the replica count that the Horizontal Pod Autoscaler wants.",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment) (kube_deployment_status_replicas_available{cluster=\"$cluster\", namespace=\"$namespace\", deployment=~\"inference|inference-gpu\"})",
          "legendFormat": "{{deployment}} available"
        },
        {
          "refId": "B",
          "expr": "max by (horizontalpodautoscaler) (kube_horizontalpodautoscaler_status_desired_replicas{cluster=\"$cluster\", namespace=\"$namespace\"})",
          "legendFormat": "autoscaler wants"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Nodes",
      "description": "Nodes in the cluster, and the nodes that have a GPU. Node autoprovisioning adds and removes nodes as pods need them.",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_node_info{cluster=\"$cluster\"})",
          "legendFormat": "all nodes"
        },
        {
          "refId": "B",
          "expr": "count(kube_node_status_allocatable{cluster=\"$cluster\", resource=\"nvidia_com_gpu\"} > 0) or vector(0)",
          "legendFormat": "GPU nodes"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU utilization",
      "description": "GPU utilization that the DCGM exporter reports on AKS-managed GPU nodes. It's empty until a GPU node exists. If it stays empty while the GPU pod runs, check that the DCGM exporter target is enabled in ama-metrics-settings-configmap.",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (Hostname, gpu) (DCGM_FI_DEV_GPU_UTIL{cluster=\"$cluster\"})",
          "legendFormat": "{{Hostname}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Ray pods CPU (Exercise 5)",
      "description": "CPU use of the Ray head and worker pods in the ray namespace. The workers are busy while the notebook's batch job runs.",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{cluster=\"$cluster\", namespace=\"ray\", container=~\"ray-head|ray-worker\"}[1m]))",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 2 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
